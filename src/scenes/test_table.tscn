[sub_resource type="GDScript" id="GDScript_h3v31"]
script/source = "extends Node2D

# prototype respawn function. space reloads current scene. sucks but i just wanted to get table walls onto main, i'll fix it later
func _process(delta: float) -> void:
	if Input.is_action_just_pressed(\"debug respawn\"):
		get_tree().reload_current_scene
"

