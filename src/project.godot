; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[addons]

curved_lines_2d/add_collision_type=1
curved_lines_2d/add_stroke_enabled=false
curved_lines_2d/snap_to_pixel=true
curved_lines_2d/snap_resolution=8.0

[application]

config/name="Breakfast Machine"
run/main_scene="uid://dsqf3abs40vat"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://dwq6rk1chemdm"

[display]

window/size/viewport_width=540
window/size/viewport_height=960
window/stretch/mode="canvas_items"

[global_group]

hittable_object="Bumpers, targets, etc that the ball may hit."
spinner="targets that activate as the ball passes through and check the ball's speed. paired with hittable_object"
drop_target="targets that take a single hit and disable themselves. paired with hittable_object"
walls="outer walls and any other solid walls that don't do anything except be in the way"
round_bumper=""
damage_kicker=""
thin_walls="thin, one-way walls and platforms"
goal_zones="get the egg here to win the game"

