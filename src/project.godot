[layer_names]

2d_physics/layer_1="Eggs"
2d_physics/layer_2="DropTargets"
2d_physics/layer_3="spinners"
2d_physics/layer_4="OneWayPlatforms"
2d_physics/layer_5="roundBumper"
2d_physics/layer_6="walls"
2d_physics/layer_7="flippers"
2d_physics/layer_8="GoalAreas"

[physics]

common/physics_ticks_per_second=120
3d/physics_engine="Jolt Physics"
